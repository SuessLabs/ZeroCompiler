; FUTURE ELF ONLY: draft imports for Linux with glibc 2.34 or newer.
; Linux sockets are file descriptors: close them with close (files.zh).
; No WSAStartup is required. sockaddr/addrinfo layouts are not defined here.
#IMPORT libc.so.6, socket, socketpair, bind, listen, accept, connect, shutdown
#IMPORT libc.so.6, send, recv, sendto, recvfrom, setsockopt, getsockopt, getsockname, getpeername
#IMPORT libc.so.6, htons, htonl, ntohs, ntohl, inet_pton, inet_ntop
#IMPORT libc.so.6, getaddrinfo, freeaddrinfo, getnameinfo, gethostname
