; DRAFT ELF SHARED-LIBRARY SUPPORT: imports for Linux with glibc 2.34 or newer.
; glibc 2.34 integrated libpthread into libc; older glibc needs another profile.
; pthread_t, mutex/condition layouts, callback ABIs, and lifetimes need definitions.
#IMPORT libc.so.6, pthread_create, pthread_join, pthread_detach, pthread_self, pthread_exit
#IMPORT libc.so.6, pthread_mutex_init, pthread_mutex_destroy, pthread_mutex_lock, pthread_mutex_unlock
#IMPORT libc.so.6, pthread_cond_init, pthread_cond_destroy, pthread_cond_wait, pthread_cond_signal, pthread_cond_broadcast
