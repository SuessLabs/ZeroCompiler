; Linux x86-64 ELF64: increment and print a uint32_t every second, without libc.
; A uint32_t is 32 bits; QWORD means 64 bits. R12D holds the counter.
; Compile: ./zcc samples/elf-x64-timer.zasm elf-x64-timer
; Run on Linux/WSL: chmod +x elf-x64-timer && ./elf-x64-timer
; Prints 1, 2, 3, ... until Ctrl+C. The counter wraps after 4294967295.
#TARGET linux-x64

  jmp start

; Decimal place values avoid DIV, which Zero does not yet implement.
decimal_places: dd 1000000000, 100000000, 10000000, 1000000, 100000, 10000, 1000, 100, 10, 1

start:
  mov r13, 0x8000000000000000 ; Sign-bit mask for negative syscall results.
  mov eax, 283             ; SYS_timerfd_create.
  mov edi, 1               ; CLOCK_MONOTONIC: wall-clock changes do not affect it.
  xor esi, esi             ; Blocking descriptor, no flags.
  syscall
  test rax, r13
  jnz failed
  mov r14, rax             ; R14 = timer descriptor.

  ; Writable itimerspec on the stack: interval {1, 0}, initial value {1, 0}.
  ; Each timespec is two 64-bit values: seconds, nanoseconds.
  push 0
  push 1
  push 0
  push 1
  mov eax, 286             ; SYS_timerfd_settime.
  mov rdi, r14
  xor esi, esi             ; Relative initial expiry.
  mov rdx, rsp
  xor r10d, r10d           ; old_value = NULL.
  syscall
  add rsp, 32
  cmp rax, 0
  jnz failed

  sub rsp, 40              ; Eight-byte expiry count plus a 32-byte text buffer.
  xor r12d, r12d           ; uint32_t counter; 32-bit ADD wraps naturally.

timer_loop:
  mov eax, 0               ; SYS_read blocks until at least one expiry.
  mov rdi, r14
  mov rsi, rsp
  mov edx, 8               ; timerfd returns a uint64_t number of expirations.
  syscall
  cmp rax, 0xFFFFFFFFFFFFFFFC ; -EINTR: retry an interrupted read.
  jz timer_loop
  cmp rax, 8
  jnz failed
  mov rbx, [rsp]           ; Print every elapsed tick, including delayed ticks.

next_tick:
  add r12d, 1
  mov r8d, r12d            ; Zero-extended unsigned value still to convert.
  lea r15, [decimal_places]
  lea rsi, [rsp + 8]
  xor ebp, ebp             ; Number of emitted digits; zero suppresses leading 0s.

next_place:
  mov r9d, [r15]
  xor edx, edx             ; Digit for this decimal place.

subtract_place:
  mov rax, r8
  sub rax, r9
  test rax, r13            ; Negative means the remainder is below this place.
  jnz digit_ready
  mov r8, rax
  add edx, 1
  jmp subtract_place

digit_ready:
  test edx, edx
  jnz emit_digit
  test ebp, ebp
  jnz emit_digit
  cmp r9d, 1              ; Emit at least one digit, including zero on wrap.
  jnz advance_place

emit_digit:
  mov eax, edx
  add eax, 48              ; ASCII '0'.
  mov [rsi], eax           ; Overlapping DWORD stores: only the first byte stays.
  add rsi, 1               ; The extra bytes fit in the padded stack buffer.
  add ebp, 1

advance_place:
  add r15, 4
  cmp r9d, 1
  jnz next_place
  mov eax, 10              ; Append LF, without a terminating zero in the output.
  mov [rsi], eax
  add ebp, 1
  lea rsi, [rsp + 8]
  mov edx, ebp

write_line:
  mov eax, 1               ; SYS_write(stdout, buffer, length).
  mov edi, 1
  syscall
  cmp rax, 0xFFFFFFFFFFFFFFFC ; -EINTR: retry the same buffer.
  jz write_line
  test rax, r13
  jnz failed
  test rax, rax
  jz failed
  add rsi, rax             ; Handle a short write by writing the remaining bytes.
  sub rdx, rax
  jnz write_line
  sub rbx, 1
  jnz next_tick
  jmp timer_loop

failed:
  mov eax, 60              ; SYS_exit; Linux also closes the timer descriptor.
  mov edi, 1
  syscall
