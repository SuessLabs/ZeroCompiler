; Windows x86 GUI: a label, an editable textbox, and a working button.
; From the published folder:
;   .\zero.exe run samples\hello-win86-controls.zasm
; Click "Show message" to display the textbox's current text. Close the main
; window to exit. This is a native Win32 window; it does not require .NET Forms.

#IMPORT kernel32.dll, GetModuleHandleA, ExitProcess
#IMPORT user32.dll, LoadCursorA, RegisterClassA, CreateWindowExA, ShowWindow, UpdateWindow
#IMPORT user32.dll, GetMessageA, IsDialogMessageA, TranslateMessage, DispatchMessageA
#IMPORT user32.dll, DefWindowProcA, PostQuitMessage, GetDlgItemTextA, MessageBoxA

  jmp start

window_class db 'ZeroWin86Controls', 0
window_title db 'Zero - Windows x86 controls', 0
label_class  db 'STATIC', 0
edit_class   db 'EDIT', 0
button_class db 'BUTTON', 0
label_text   db 'Enter a message:', 0
initial_text db 'Hello Zero!', 0
button_text  db 'Show message', 0

start:
  push 0
  call [GetModuleHandleA]
  push eax
  pop esi                 ; ESI = this application's instance handle.

  push 32512              ; IDC_ARROW.
  push 0
  call [LoadCursorA]
  push eax
  pop edi                 ; EDI = arrow cursor.

  ; Build the 40-byte WNDCLASSA structure on the stack, last field first.
  push window_class       ; lpszClassName.
  push 0                  ; lpszMenuName.
  push 16                 ; hbrBackground = COLOR_BTNFACE + 1.
  push edi                ; hCursor.
  push 0                  ; hIcon (use the default icon).
  push esi                ; hInstance.
  push 0                  ; cbWndExtra.
  push 0                  ; cbClsExtra.
  push window_proc        ; lpfnWndProc = callback below.
  push 3                  ; style = CS_HREDRAW | CS_VREDRAW.
  lea eax, [esp]
  push eax
  call [RegisterClassA]
  add esp, 40             ; Release our copy of WNDCLASSA.
  test eax, eax
  jz failed

  ; CreateWindowExA arguments are pushed right to left.
  push 0                  ; lpParam.
  push esi                ; hInstance.
  push 0                  ; hMenu.
  push 0                  ; hWndParent.
  push 220                ; Height, including the title bar and frame.
  push 420                ; Width.
  push 0x80000000         ; y = CW_USEDEFAULT.
  push 0x80000000         ; x = CW_USEDEFAULT.
  push 0x00CF0000         ; WS_OVERLAPPEDWINDOW.
  push window_title
  push window_class
  push 0                  ; Extended window style.
  call [CreateWindowExA]
  test eax, eax
  jz failed
  push eax
  pop ebx                 ; EBX = main window handle.

  ; Label: STATIC control, ID 101, at (20, 18), size 350 x 22.
  push 0
  push esi
  push 101
  push ebx
  push 22
  push 350
  push 18
  push 20
  push 0x50000000         ; WS_CHILD | WS_VISIBLE.
  push label_text
  push label_class
  push 0
  call [CreateWindowExA]
  test eax, eax
  jz failed

  ; Textbox: EDIT control, ID 102, at (20, 46), size 350 x 26.
  push 0
  push esi
  push 102
  push ebx
  push 26
  push 350
  push 46
  push 20
  push 0x50810080         ; CHILD | VISIBLE | BORDER | TABSTOP | ES_AUTOHSCROLL.
  push initial_text
  push edit_class
  push 0
  call [CreateWindowExA]
  test eax, eax
  jz failed

  ; Button: BUTTON control, ID 103, at (20, 90), size 140 x 32.
  push 0
  push esi
  push 103
  push ebx
  push 32
  push 140
  push 90
  push 20
  push 0x50010001         ; CHILD | VISIBLE | TABSTOP | BS_DEFPUSHBUTTON.
  push button_text
  push button_class
  push 0
  call [CreateWindowExA]
  test eax, eax
  jz failed

  push 1                  ; SW_SHOWNORMAL.
  push ebx
  call [ShowWindow]
  push ebx
  call [UpdateWindow]

  ; Reserve a writable 32-byte x86 MSG structure.
  sub esp, 32
  lea edi, [esp]

message_loop:
  push 0
  push 0
  push 0
  push edi
  call [GetMessageA]
  test eax, eax
  jz finished             ; WM_QUIT ends the loop.
  cmp eax, 0xFFFFFFFF     ; GetMessage returns -1 on error.
  jz failed

  push edi
  push ebx
  call [IsDialogMessageA] ; Handle Tab and Enter for the child controls.
  test eax, eax
  jnz message_loop

  push edi
  call [TranslateMessage]
  push edi
  call [DispatchMessageA]
  jmp message_loop

finished:
  push 0
  call [ExitProcess]

failed:
  push 1
  call [ExitProcess]

; Windows calls this stdcall function with four 32-bit arguments.
; Saving EBP gives stable offsets: +8 hwnd, +12 message, +16 wParam, +20 lParam.
window_proc:
  push ebp
  lea ebp, [esp]
  mov eax, [ebp + 12]
  cmp eax, 2              ; WM_DESTROY.
  jz window_destroyed
  cmp eax, 0x0111         ; WM_COMMAND.
  jz window_command

default_message:
  mov eax, [ebp + 20]
  push eax
  mov eax, [ebp + 16]
  push eax
  mov eax, [ebp + 12]
  push eax
  mov eax, [ebp + 8]
  push eax
  call [DefWindowProcA]
  pop ebp
  ret 16                  ; Return and remove the four callback arguments.

window_command:
  mov eax, [ebp + 16]
  cmp eax, 103            ; Button ID 103 with BN_CLICKED (notification code 0).
  jnz default_message

  push esi                ; Preserve the caller's ESI before using it locally.
  sub esp, 256
  lea esi, [esp]          ; Buffer for up to 255 characters and an ending zero.
  push 256
  push esi
  push 102                ; Textbox ID.
  mov eax, [ebp + 8]
  push eax
  call [GetDlgItemTextA]

  push 0x40               ; MB_OK | MB_ICONINFORMATION.
  push window_title
  push esi
  mov eax, [ebp + 8]
  push eax
  call [MessageBoxA]
  add esp, 256
  pop esi
  mov eax, 0
  pop ebp
  ret 16

window_destroyed:
  push 0
  call [PostQuitMessage]
  mov eax, 0
  pop ebp
  ret 16
