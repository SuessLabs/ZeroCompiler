digraph "Zero IDE — Debug" {
  compound=true;
  fontsize=12;
  "ValidateCompiler" [shape=box, style=rounded, label="1. ValidateCompilerState"];
  "Save" [shape=box, style=rounded, label="2. SaveSourceState"];
  "ValidateSource" [shape=box, style=rounded, label="3. ValidateSourceState"];
  "Build" [shape=box, style=rounded, label="4. CompileState"];
  "Completed" [shape=box, style=rounded, label="6. CompletedState"];
  "Canceled" [shape=box, style=rounded, label="2a. CanceledState"];
  "Failed" [shape=box, style=rounded, label="FailedState"];
  "Launch" [shape=box, style=rounded, label="5. LaunchState"];
  "ValidateCompiler" -> "Save" [color="#2563EB", label="Success"];
  "ValidateCompiler" -> "Failed" [color="#B91C1C", label="Error"];
  "Save" -> "ValidateSource" [color="#2563EB", label="Success"];
  "Save" -> "Failed" [color="#B91C1C", label="Error"];
  "Save" -> "Canceled" [color="#B45309", label="Failure"];
  "ValidateSource" -> "Build" [color="#2563EB", label="Success"];
  "ValidateSource" -> "Failed" [color="#B91C1C", label="Error"];
  "Build" -> "Launch" [color="#2563EB", label="Success"];
  "Build" -> "Failed" [color="#B91C1C", label="Error"];
  "Launch" -> "Completed" [color="#2563EB", label="Success"];
  "Launch" -> "Failed" [color="#B91C1C", label="Error"];
  "start_global" [shape=circle, style=filled, fillcolor="black", color="black", label="", width=0.25, height=0.25, fixedsize=true];
  "start_global" -> "ValidateCompiler" [color="black", label="start"];
  "final_global" [shape=doublecircle, style=filled, fillcolor="black", color="black", label="", width=0.35, height=0.35, fixedsize=true];
  "Completed" -> "final_global" [color="black", label="final"];
  "Canceled" -> "final_global" [color="black", label="final"];
  "Failed" -> "final_global" [color="black", label="final"];
}
