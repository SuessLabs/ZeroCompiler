<Project>
  <!-- Load the editor's defaults first; other projects keep the compiler defaults below. -->
  <Import Project="$(MSBuildThisFileDirectory)Zero.Ide/Version.props"
          Condition="'$(MSBuildProjectName)' == 'Zero.Ide'" />

  <PropertyGroup>
    <Company>Xeno Innovations, Inc.</Company>
    <Authors>Damian Suess</Authors>
    <Copyright>Copyright © Xeno Innovations, Inc. 2001-$([System.DateTime]::Now.ToString(yyyy))</Copyright>
    <!--<Description></Description>-->
    <!--<Product>Zero Compiler</Product>-->
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Zero.Ide'">
    <!-- The SDK derives assembly, file, and informational versions from Version. -->
    <!-- Compiler/CLI defaults. CompilerVersion and IdeVersion allow independent CI overrides. -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.0.4.6</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''"></VersionSuffix>
    <Version Condition="'$(MSBuildProjectName)' != 'Zero.Ide' And '$(CompilerVersion)' != ''">$(CompilerVersion)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>

    <BaseOutputPath>../../output/$(MSBuildProjectName)</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Excludes all satellite assemblies -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <!-- HotReload Bug: https://github.com/dotnet/sdk/issues/36666#issuecomment-1814835637 -->
    <EnableSourceControlManagerQueries>true</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <!--
  <ItemGroup>
    <AdditionalFiles Include="../stylecop.json" />
    < ! - - https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/Microsoft.CodeAnalysis.BannedApiAnalyzers/BannedApiAnalyzers.Help.md - ->
    <None Remove="../BannedSymbols.txt" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
  </ItemGroup>
  -->
</Project>
