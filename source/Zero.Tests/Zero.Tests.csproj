<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zero\Zero.csproj" />
    <ProjectReference Include="..\Zero.Cli\Zero.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../include/**/*.zh"
                      LogicalName="Include/%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
    <Content Include="../../include/**/*"
             Link="Include/%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="include/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../samples/**/*.zasm"
                      Link="Samples/%(RecursiveDir)%(Filename)%(Extension)"
                      LogicalName="Samples/%(RecursiveDir)%(Filename)%(Extension)"
                      TargetPath="samples/%(RecursiveDir)%(Filename)%(Extension)"
                      CopyToOutputDirectory="PreserveNewest"
                      WithCulture="false" />
  </ItemGroup>

</Project>
