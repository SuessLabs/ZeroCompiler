<Project>
  <!-- Edit these three versions here. CI can override each property independently. -->
  <PropertyGroup>
    <CompilerVersion Condition="'$(CompilerVersion)' == ''">0.2.1.3</CompilerVersion>
    <IdeVersion Condition="'$(IdeVersion)' == ''">0.2.1.3</IdeVersion>
    <DebuggerVersion Condition="'$(DebuggerVersion)' == ''">0.2.1.3</DebuggerVersion>
  </PropertyGroup>

  <!-- Tests and debugger backends follow their product's version. -->
  <PropertyGroup Condition="'$(VersionPrefix)' == ''">
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Zero.Ide'))">$(IdeVersion)</VersionPrefix>
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Zero.Dbg'))">$(DebuggerVersion)</VersionPrefix>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">$(CompilerVersion)</VersionPrefix>
  </PropertyGroup>
</Project>
