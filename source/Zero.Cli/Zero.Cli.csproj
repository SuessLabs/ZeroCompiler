<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Title>Zero Language Compiler</Title>
    <Description>Compiler for the Zero programming language and Zero assembly.</Description>
    <ApplicationIcon>z3-16-48.ico</ApplicationIcon>
    <AssemblyName>zcc</AssemblyName>
    <AssemblyTitle>Zero Language Compiler</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OptimizationPreference Condition="'$(OptimizationPreference)' == ''">Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zero\Zero.csproj" />
  </ItemGroup>

</Project>
