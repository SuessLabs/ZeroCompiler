<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Title>Zero Language Compiler</Title>
    <Description>Compiler for the Zero programming language and Zero assembly.</Description>
    <ApplicationIcon>z3-16-48.ico</ApplicationIcon>
    <AssemblyName>zero</AssemblyName>
    <RootNamespace>Zero.Cli</RootNamespace>
    <AssemblyTitle>Zero Language Compiler</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OptimizationPreference Condition="'$(OptimizationPreference)' == ''">Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zero\Zero.csproj" />
    <InternalsVisibleTo Include="Zero.Tests" />
  </ItemGroup>

  <!-- Remove artifacts from the former CLI name when reusing an output folder. -->
  <Target Name="RemoveLegacyCompilerArtifacts" AfterTargets="Build;Publish">
    <Delete Files="$(TargetDir)zcc.exe;$(TargetDir)zcc;$(TargetDir)zcc.dll;$(TargetDir)zcc.deps.json;$(TargetDir)zcc.runtimeconfig.json;$(TargetDir)zcc.pdb" />
    <Delete Condition="'$(PublishDir)' != ''"
            Files="$(PublishDir)zcc.exe;$(PublishDir)zcc;$(PublishDir)zcc.dll;$(PublishDir)zcc.deps.json;$(PublishDir)zcc.runtimeconfig.json;$(PublishDir)zcc.pdb" />
  </Target>

</Project>
