<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docking="using:Zero.Ide.Docking"
             xmlns:views="using:Zero.Ide.Views"
             xmlns:vm="using:Zero.Ide.ViewModels"
             x:Class="Zero.Ide.App"
             RequestedThemeVariant="Default">
  <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

  <Application.DataTemplates>
    <DataTemplate DataType="docking:EditorDocument">
      <views:EditorView DataContext="{Binding Editor}" />
    </DataTemplate>
    <DataTemplate DataType="vm:SolutionExplorerViewModel">
      <views:SolutionExplorerView />
    </DataTemplate>
    <DataTemplate DataType="vm:DebuggerViewModel">
      <views:DebuggerView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <DockFluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Zero.Ide/Themes/IdeStyles.axaml" />
  </Application.Styles>
</Application>
