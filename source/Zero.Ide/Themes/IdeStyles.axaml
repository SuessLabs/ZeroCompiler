<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:area="using:AvaloniaEdit.Editing"
        xmlns:edit="using:AvaloniaEdit">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource IdeWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IdeTextBrush}" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource IdeChromeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IdeTextBrush}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource IdeTextBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource IdePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IdeBorderBrush}" />
  </Style>
  <Style Selector="Button, ComboBox, NumericUpDown, TextBox">
    <Setter Property="Background" Value="{DynamicResource IdePanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IdeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IdeBorderBrush}" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource IdeHoverBrush}" />
  </Style>
  <Style Selector="Button.toolbar-icon">
    <Style.Resources>
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    </Style.Resources>
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.toolbar-icon:pointerover">
    <Setter Property="Background" Value="{DynamicResource IdeHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IdeBorderBrush}" />
  </Style>
  <Style Selector="Button.toolbar-icon Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource IdeTextBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.toolbar-icon:disabled Path">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.play Path">
    <Setter Property="Fill" Value="#5BA853" />
    <Setter Property="Stroke" Value="#5BA853" />
  </Style>
  <Style Selector="Separator.toolbar-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource IdeBorderBrush}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CaretBrush" Value="{DynamicResource IdeTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource IdeSelectionBrush}" />
  </Style>
  <Style Selector="TreeView">
    <Setter Property="Background" Value="{DynamicResource IdePanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IdeTextBrush}" />
  </Style>
  <Style Selector="Border.toolbar, Border.status-bar">
    <Setter Property="Background" Value="{DynamicResource IdeChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IdeBorderBrush}" />
  </Style>
  <Style Selector="edit|TextEditor">
    <Setter Property="Background" Value="{DynamicResource IdeEditorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IdeTextBrush}" />
    <Setter Property="LineNumbersForeground" Value="{DynamicResource IdeLineNumbersBrush}" />
  </Style>
  <Style Selector="area|TextArea">
    <Setter Property="SelectionBrush" Value="{DynamicResource IdeSelectionBrush}" />
    <Setter Property="SelectionForeground" Value="{DynamicResource IdeTextBrush}" />
  </Style>
</Styles>
