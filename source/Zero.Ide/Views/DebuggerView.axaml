<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dbg="using:Zero.Dbg"
             xmlns:vm="using:Zero.Ide.ViewModels"
             x:Class="Zero.Ide.Views.DebuggerView"
             x:DataType="vm:DebuggerViewModel">
  <Grid Margin="10"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="6">
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Location}"
               Grid.Row="1"
               FontSize="11"
               TextWrapping="Wrap" />
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Registers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dbg:RegisterValue">
            <StackPanel Margin="0,4,22,4"
                        Orientation="Horizontal"
                        Spacing="8">
              <TextBlock Text="{Binding Name}"
                         Width="54"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding Hex}" FontFamily="Cascadia Code, Consolas, monospace" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
