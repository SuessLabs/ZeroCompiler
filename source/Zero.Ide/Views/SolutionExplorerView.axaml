<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Zero.Ide.Models"
             xmlns:vm="using:Zero.Ide.ViewModels"
             x:Class="Zero.Ide.Views.SolutionExplorerView"
             x:DataType="vm:SolutionExplorerViewModel">
  <DockPanel Background="{DynamicResource IdePanelBrush}">
    <StackPanel Margin="8"
                DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="6">
      <Button Content="Open Folder..." Command="{Binding CmdOpenFolder}" />
      <Button Content="↻"
              AutomationProperties.Name="Refresh workspace"
              Command="{Binding CmdRefresh}"
              ToolTip.Tip="Refresh workspace" />
    </StackPanel>
    <TreeView x:Name="WorkspaceTree"
              DoubleTapped="OnItemDoubleTapped"
              ItemsSource="{Binding Roots}">
      <TreeView.Styles>
        <Style x:DataType="models:WorkspaceNode" Selector="TreeViewItem">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="models:WorkspaceNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      ToolTip.Tip="{Binding Path}">
            <TextBlock Text="▸"
                       Foreground="{DynamicResource IdeAccentBrush}"
                       IsVisible="{Binding IsDirectory}" />
            <TextBlock Text="{Binding Name}" />
            <TextBlock Text="!"
                       Foreground="IndianRed"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="{Binding ErrorMessage}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
