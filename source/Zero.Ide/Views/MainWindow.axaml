<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:views="using:Zero.Ide.Views"
        xmlns:vm="using:Zero.Ide.ViewModels"
        x:Class="Zero.Ide.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Width="1100"
        Height="750"
        MinWidth="800"
        MinHeight="400"
        Icon="/Assets/zero-logo.ico"
        mc:Ignorable="d">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Zero.Ide/Themes/ToolbarIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Command="{Binding CmdNew}" Gesture="Ctrl+N" />
    <KeyBinding Command="{Binding CmdOpen}" Gesture="Ctrl+O" />
    <KeyBinding Command="{Binding CmdSave}" Gesture="Ctrl+S" />
    <KeyBinding Command="{Binding CmdSaveAs}" Gesture="Ctrl+Shift+S" />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Command="{Binding CmdNew}"
                  Header="_New"
                  InputGesture="Ctrl+N" />
        <MenuItem Command="{Binding CmdOpen}"
                  Header="_Open"
                  InputGesture="Ctrl+O" />
        <MenuItem Command="{Binding CmdSave}"
                  Header="_Save"
                  InputGesture="Ctrl+S" />
        <MenuItem Command="{Binding CmdSaveAs}"
                  Header="Save _As..."
                  InputGesture="Ctrl+Shift+S" />

        <Separator />

        <MenuItem Command="{Binding CmdExit}" Header="E_xit" />
      </MenuItem>

      <MenuItem Header="_Edit" IsEnabled="{Binding !IsBusy}">
        <MenuItem Command="{Binding Editor.CmdUndo}"
                  Header="_Undo"
                  InputGesture="Ctrl+Z" />
        <MenuItem Command="{Binding Editor.CmdRedo}"
                  Header="_Redo"
                  InputGesture="Ctrl+Y" />

        <Separator />

        <MenuItem Command="{Binding Editor.CmdCut}"
                  Header="Cu_t"
                  InputGesture="Ctrl+X" />
        <MenuItem Command="{Binding Editor.CmdCopy}"
                  Header="_Copy"
                  InputGesture="Ctrl+C" />
        <MenuItem Command="{Binding Editor.CmdPaste}"
                  Header="_Paste"
                  InputGesture="Ctrl+V" />
      </MenuItem>

      <MenuItem Header="_Build" ToolTip.Tip="Compiler integration is planned for a later phase.">
        <MenuItem Command="{Binding CmdBuild}" Header="_Build" />
        <MenuItem Command="{Binding CmdRebuild}" Header="_Rebuild" />
        <MenuItem Command="{Binding CmdClean}" Header="_Clean" />
      </MenuItem>

      <MenuItem Header="_Tools">
        <MenuItem Command="{Binding CmdOptions}" Header="_Options..." />
        <MenuItem Header="_Themes">
          <MenuItem Command="{Binding CmdThemeSystem}"
                    GroupName="IdeTheme"
                    Header="Use _system setting"
                    IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                    ToggleType="Radio" />
          <Separator />
          <MenuItem Command="{Binding CmdThemeLight}"
                    GroupName="IdeTheme"
                    Header="_Light"
                    IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                    ToggleType="Radio" />
          <MenuItem Command="{Binding CmdThemeDark}"
                    GroupName="IdeTheme"
                    Header="_Dark"
                    IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                    ToggleType="Radio" />
          <MenuItem Command="{Binding CmdThemeCoolSlate}"
                    GroupName="IdeTheme"
                    Header="_Cool Slate"
                    IsChecked="{Binding IsCoolSlateTheme, Mode=OneWay}"
                    ToggleType="Radio" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="_Help">
        <MenuItem Command="{Binding CmdAbout}" Header="_About" />
      </MenuItem>
    </Menu>

    <Border Padding="8,6"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,1"
            Classes="toolbar"
            DockPanel.Dock="Top">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="6">
          <Button AutomationProperties.Name="New File"
                  Classes="toolbar-icon"
                  Command="{Binding CmdNew}"
                  ToolTip.Tip="New File (Ctrl+N)">
            <Path Data="{StaticResource IconNewFile}" />
          </Button>
          <Button AutomationProperties.Name="Open File"
                  Classes="toolbar-icon"
                  Command="{Binding CmdOpen}"
                  ToolTip.Tip="Open File (Ctrl+O)">
            <Path Data="{StaticResource IconOpenFile}" />
          </Button>
          <Button AutomationProperties.Name="Save File"
                  Classes="toolbar-icon"
                  Command="{Binding CmdSave}"
                  ToolTip.Tip="Save File (Ctrl+S)">
            <Path Data="{StaticResource IconSaveFile}" />
          </Button>

          <Separator Classes="toolbar-divider" />

          <Button AutomationProperties.Name="Undo Edit"
                  Classes="toolbar-icon"
                  Command="{Binding Editor.CmdUndo}"
                  ToolTip.Tip="Undo Edit (Ctrl+Z)">
            <Path Data="{StaticResource IconUndo}" />
          </Button>
          <Button AutomationProperties.Name="Redo Edit"
                  Classes="toolbar-icon"
                  Command="{Binding Editor.CmdRedo}"
                  ToolTip.Tip="Redo Edit (Ctrl+Y)">
            <Path Data="{StaticResource IconRedo}" />
          </Button>

          <Separator Classes="toolbar-divider" />

          <Button AutomationProperties.Name="Clean and Build"
                  Classes="toolbar-icon play"
                  Command="{Binding CmdRebuild}"
                  ToolTip.Tip="Clean and Build (compiler integration is planned for a later phase)">
            <Path Data="{StaticResource IconPlay}" />
          </Button>

          <ComboBox Width="104"
                    MinHeight="30"
                    Padding="8,4"
                    AutomationProperties.Name="Build Configuration"
                    IsEnabled="{Binding !IsBusy}"
                    ItemsSource="{Binding BuildConfigurations}"
                    SelectedItem="{Binding BuildConfiguration, Mode=TwoWay}"
                    ToolTip.Tip="Build Configuration" />
        </StackPanel>

        <TextBlock Text="{Binding BuildStatus}"
                   Grid.Column="1"
                   Margin="12,0"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="Build Status"
                   FontSize="12"
                   FontWeight="SemiBold" />

        <TextBox Text="{Binding Editor.SearchText, Mode=TwoWay}"
                 Grid.Column="2"
                 Width="210"
                 MinHeight="30"
                 Padding="8,4"
                 HorizontalAlignment="Right"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="Search current file"
                 IsEnabled="{Binding !IsBusy}"
                 ToolTip.Tip="Search current file (Enter: next match)"
                 Watermark="Search current file...">

          <TextBox.InnerLeftContent>
            <Path Width="14"
                  Height="14"
                  Margin="6,0,6,0"
                  Data="{StaticResource IconSearch}"
                  Stretch="Uniform"
                  Stroke="{DynamicResource IdeSecondaryBrush}"
                  StrokeThickness="1.7" />
          </TextBox.InnerLeftContent>

          <TextBox.KeyBindings>
            <KeyBinding Command="{Binding Editor.CmdFindNext}" Gesture="Enter" />
          </TextBox.KeyBindings>
        </TextBox>
      </Grid>
    </Border>

    <Border Padding="12,6"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Classes="status-bar"
            DockPanel.Dock="Bottom">
      <TextBlock Text="{Binding Status}" FontSize="12" />
    </Border>

    <views:EditorView x:Name="EditorPane" IsEnabled="{Binding !IsBusy}" />
  </DockPanel>

</Window>
