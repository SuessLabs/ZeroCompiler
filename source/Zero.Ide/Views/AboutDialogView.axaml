<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Zero.Ide.Controls"
             xmlns:vm="using:Zero.Ide.ViewModels"
             x:Class="Zero.Ide.Views.AboutDialogView"
             x:DataType="vm:AboutDialogViewModel"
             Background="{DynamicResource IdeWindowBrush}"
             Foreground="{DynamicResource IdeTextBrush}">
  <StackPanel>
    <Border Height="168"
            Margin="28,24,28,0"
            ClipToBounds="True"
            CornerRadius="10">

      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#F5F7FA" />
          <GradientStop Offset="0.45" Color="#F4E5CA" />
          <GradientStop Offset="0.76" Color="#6C3324" />
          <GradientStop Offset="1" Color="{DynamicResource IdeWindowColor}" />
        </LinearGradientBrush>
      </Border.Background>

      <Grid>
        <controls:DoomFireControl Height="112"
                                  VerticalAlignment="Bottom"
                                  ClipToBounds="True"
                                  IsHitTestVisible="False">
          <controls:DoomFireControl.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="Transparent" />
              <GradientStop Offset="0.35" Color="White" />
              <GradientStop Offset="0.75" Color="White" />
              <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
          </controls:DoomFireControl.OpacityMask>
        </controls:DoomFireControl>

        <Image Width="420"
               Height="140"
               Margin="20,16,20,0"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Source="/Assets/zero-logo.png"
               AutomationProperties.Name="Zero project logo"
               Stretch="Uniform" />
      </Grid>
    </Border>

    <StackPanel Margin="28,20,28,24" Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Text="Zero IDE"
                   FontSize="26"
                   FontWeight="SemiBold" />
        <TextBlock Text="LOW-LEVEL ROOTS. A NEW GENERATION."
                   FontSize="11"
                   Foreground="{DynamicResource IdeSecondaryBrush}"
                   LetterSpacing="1.4" />
      </StackPanel>
      <Border Padding="14,10"
              Background="{DynamicResource IdePanelBrush}"
              CornerRadius="6">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <TextBlock Text="IDE VERSION"
                     FontSize="10"
                     Foreground="{DynamicResource IdeSecondaryBrush}" />
          <TextBlock Text="COMPILER VERSION"
                     Grid.Column="1"
                     FontSize="10"
                     Foreground="{DynamicResource IdeSecondaryBrush}" />
          <TextBlock Text="{Binding IdeVersion}"
                     Grid.Row="1"
                     Margin="0,4,0,0"
                     FontSize="16"
                     Foreground="{DynamicResource IdeAccentBrush}" />
          <TextBlock Text="{Binding CompilerVersion}"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,4,0,0"
                     FontSize="16"
                     Foreground="{DynamicResource IdeAccentBrush}" />
        </Grid>
      </Border>

      <TextBlock Text="The Zero programming language and compiler project. A modern home for low-level code, with roots reaching back to 2001."
                 FontSize="13"
                 LineHeight="20"
                 TextWrapping="Wrap" />
      <TextBlock Text="Edit Zero assembly for Windows x86 and Linux x86-64. Built with Avalonia and Prism."
                 FontSize="13"
                 Foreground="{DynamicResource IdeSecondaryBrush}"
                 LineHeight="20"
                 TextWrapping="Wrap" />

      <StackPanel Spacing="4">
        <TextBlock Text="Created by Damian Suess" FontSize="12" />
        <TextBlock Text="{Binding Copyright}"
                   FontSize="11"
                   Foreground="{DynamicResource IdeSecondaryBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="Open source · MIT License"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource IdeSecondaryBrush}" />
        <Button Content="Close"
                Grid.Column="1"
                MinWidth="96"
                Command="{Binding CmdClose}"
                IsCancel="True"
                IsDefault="True" />
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
