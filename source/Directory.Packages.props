    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Lite.EventIpc" Version="1.3.2" />
    <PackageVersion Include="Lite.StateMachine" Version="2.4.1" />
